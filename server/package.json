{
  "name": "nature360-server",
  "private": true,
  "version": "1.0.0",
  "description": "Nature360 complaint tracking API (Express + MongoDB)",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
