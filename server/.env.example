# Local server configuration.
PORT=5000

# MongoDB connection string. For Atlas, URL-encode special characters in the
# password (@ -> %40, # -> %23) and allow your IP in Atlas -> Network Access.
# For a local server use: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# The application database. Must match the database that holds your complaints.
MONGODB_DB=nature360

# If MONGODB_URI is unreachable, start an embedded MongoDB for local development.
# Data is stored in server/.data/mongodb and survives restarts. Never used in production.
# WARNING: the embedded database starts empty, so dashboards will show no data
# until complaints are created. Fix MONGODB_URI to use your real database.
MONGODB_EMBEDDED_FALLBACK=true

# Public Firebase Web API key (same value as VITE_FIREBASE_API_KEY in client/.env).
FIREBASE_API_KEY=<your-firebase-web-api-key>

# Comma-separated browser origins allowed to call the API.
# In production add your Vercel URL, e.g. https://nature360.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5199

# Optional role bootstrap. New sign-ins with these emails receive the role;
# existing accounts are promoted when they sign in again.
ADMIN_EMAILS=
OFFICER_EMAILS=
VOLUNTEER_EMAILS=
