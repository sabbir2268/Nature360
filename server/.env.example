# Server
PORT=5000

# MongoDB (Atlas or local). Example Atlas URI:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name. Defaults to the one in the URI.
MONGODB_DB=nature360

# If MONGODB_URI is unreachable, start an embedded MongoDB for local development.
# Data is stored in server/.data/mongodb and survives restarts. Never used in production.
MONGODB_EMBEDDED_FALLBACK=true

# Firebase Web API key (same value as VITE_FIREBASE_API_KEY in client/.env).
# Used to verify the ID token every request sends in the Authorization header.
FIREBASE_API_KEY=

# Comma separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:5199

# Bootstrap roles by email. New sign-ins with these emails receive the role;
# existing accounts are promoted when they sign in again. Admin can also change
# roles from the dashboard.
ADMIN_EMAILS=
OFFICER_EMAILS=
VOLUNTEER_EMAILS=
